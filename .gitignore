# LocalBazar .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE and Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Files
*.tmp
*.temp
.cache/
temp/
tmp/

# Documentation Build (keep source, ignore compiled)
eCommerce Doc/

# Backup Files
*.bak
*.backup
*-backup/
backup/

# Node modules (if you add npm later)
node_modules/
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# Build outputs (if you add build process)
dist/
build/

# Compressed files
*.zip
*.rar
*.7z
*.tar.gz

# Large media files (optional - uncomment if needed)
# *.mp4
# *.mov
# *.avi

# Test files (optional)
test/
tests/
*.test.js

# Coverage directory
coverage/

# Misc
.htpasswd
error_log
.ftpconfig
sftp-config.json
